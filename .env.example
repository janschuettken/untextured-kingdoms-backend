# Kopieren nach .env und anpassen:  cp .env.example .env
#
# Port, auf dem das Spiel lokal (nur 127.0.0.1) lauscht. Apache leitet dorthin weiter.
WEB_PORT=8081
# Accounts mit diesen Namen (durch Komma getrennt) werden Admins: Admin-Menü und Balancing-Editor.
# Account erst in der Lobby anlegen; beim nächsten Start bekommt er die Rechte fest eingetragen.
ADMIN_USERS=Jan
# Passwort der Datenbank (Dienst "db"). Pflicht. Nur Buchstaben/Ziffern, z. B.:  openssl rand -hex 24
DB_PASSWORD=
# Port der Datenbank, nur auf 127.0.0.1 (für DBeaver per SSH-Tunnel).
DB_PORT=5433
# Adminer (Datenbank im Browser), nur auf 127.0.0.1, per SSH-Tunnel.
ADMINER_PORT=8082
# Nur falls eine Datenbank außerhalb von Docker benutzt werden soll, sonst leer lassen.
# z. B. postgres://uk:passwort@localhost:5432/untextured_kingdoms
DATABASE_URL=

# ---------- E-Mails ("Passwort vergessen") ----------
# Adresse der Seite, für den Link in der Mail.
PUBLIC_URL=https://untexturedkingdoms.jan-schuettken.de
# Mailserver (SMTP). Leer = keine Mails; der Link steht dann nur im Server-Log
# (docker compose logs server | grep reset.html).
# Port 587 = STARTTLS, 465 = TLS von Anfang an.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Absender, z. B.: Untextured Kingdoms <spiel@jan-schuettken.de>
SMTP_FROM=
