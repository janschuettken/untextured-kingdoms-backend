# Kopieren nach .env und anpassen.
# ":80" für einen Test ohne Domain, sonst deine Domain (z. B. rts.example.de) für automatisches HTTPS.
SITE_ADDRESS=:80
# Admin-Token für Admin-Menü und Balancing-Editor. Leer lassen = jeder ist Admin, ohne Anmeldung (vorerst so gewollt).
# Ein langes zufälliges Wort, z. B. aus: openssl rand -hex 16
ADMIN_TOKEN=
